{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "api/investigate.ts": {
      "maxDuration": 30,
      "includeFiles": "src/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/lookup",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/investigations",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/investigation/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/project",
      "destination": "/project/index.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/how-it-works/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/lookup",
      "destination": "/index.html"
    },
    {
      "source": "/investigations",
      "destination": "/index.html"
    },
    {
      "source": "/investigation/:id",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies/index.html"
    },
    {
      "source": "/disclosures",
      "destination": "/disclosures/index.html"
    }
  ]
}
