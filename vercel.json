{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "api/investigate.ts": {
      "maxDuration": 30,
      "includeFiles": "src/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/investigations",
      "destination": "/index.html"
    },
    {
      "source": "/investigation/:id",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/index.html"
    },
    {
      "source": "/disclosures",
      "destination": "/index.html"
    }
  ]
}