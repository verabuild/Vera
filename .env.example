# URLhaus malware URL intelligence (free abuse.ch Auth-Key; server-side only)
URLHAUS_AUTH_KEY=

# Public web reputation search (Tavily; optional, server-side only; free tier available)
TAVILY_API_KEY=

# Google Gemini (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Solana
SOLANA_MAINNET_RPC_URL=https://api.mainnet.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=both
VERA_TEST_WALLET=4AMBqkqruwzT4RMh9sojo7RmBgYLYTuqGmv2GbAtXsVL

# Magic Eden Solana API
MAGIC_EDEN_API_KEY=
